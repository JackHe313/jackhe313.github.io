---
import { load } from "../lib/data";
const education = load("education.yaml");
---

<section id="education" class="py-20 md:py-28 px-6 bg-surface-sunken scroll-mt-16">
  <div class="max-w-[960px] mx-auto">
    <p class="text-[14px] font-mono text-accent tracking-[0.12em] uppercase mb-3">{education.label}</p>
    <h2 class="font-display text-[32px] md:text-[44px] font-bold text-ink mb-10">{education.heading}</h2>
    <div class="space-y-5">
      {education.degrees.map((d: any) => (
        <article class="card-glow bg-surface-raised rounded-[8px] p-7 md:p-9">
          <div class="flex flex-col sm:flex-row sm:justify-between gap-4 mb-4">
            <h3 class="text-[22px] font-bold max-w-[580px]">{d.degree}</h3>
            <p class="text-[13px] font-mono text-accent shrink-0">{d.dateRange}</p>
          </div>
          <p class="text-ink-secondary">{d.institution}</p>
          {d.highlights.length > 0 && (
            <ul class="mt-4 space-y-2 text-[15px] text-ink-secondary">
              {d.highlights.map((h: string) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
